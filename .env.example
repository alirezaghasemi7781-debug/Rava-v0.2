# Rava — local / frontend environment (Vite)
# Copy to `.env.local` and fill values. Never commit `.env.local`.

# --- Supabase (client / anon only) ---
VITE_SUPABASE_URL=https://thmsfdugojokxtemnqdw.supabase.co
VITE_SUPABASE_ANON_KEY=

# --- Google (browser) ---
# Used by MainMap, routing (Maps JS Directions), Place details.
VITE_GOOGLE_MAPS_API_KEY=

# Used by Gemini Live (mic), DailyCurator, BargainCalculator, place vibe, recap.
# This is a CLIENT key (bundled into the web app). Restrict by HTTP referrer in Google Cloud.
# Edge Functions use a SEPARATE Supabase secret named GEMINI_API_KEY (already configured).
VITE_GEMINI_API_KEY=

# Optional alias some legacy code paths check (prefer VITE_GEMINI_API_KEY):
# API_KEY=
