                />
              ))}
            </div>
          </div>
        ))}

        <button 
          onClick={handleLogout}
          className="w-full py-6 rounded-[2.2rem] bg-red-500/5 border border-red-500/10 flex items-center justify-center gap-3 active:scale-95 transition-all group"
        >
