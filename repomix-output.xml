          <ControlActions onDisconnect={disconnect} onInterrupt={interrupt} />
        </div>

        <div className="relative z-20 pointer-events-auto scale-90">
          <MicTrigger onStart={connect} />
        </div>
      </div>
    </div>
  );
};
